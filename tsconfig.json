{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // scripts/ é excluído porque são utilitários de linha de comando,
  // corridos com tsx (permissive), e não devem entrar no bundle do
  // Next.js. Já rebentou o deploy uma vez porque um script usava
  // literais BigInt (0n) — fora do bundle isso não importa; dentro
  // do build do Next parte tudo em silêncio até alguém abrir o site.
  // Se precisares de type-check aos scripts, corre `npx tsc -p
  // tsconfig.scripts.json --noEmit` (target ES2022, permite BigInt).
  "exclude": ["node_modules", "scripts"]
}
